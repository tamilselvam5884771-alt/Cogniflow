# Application Configuration
APP_NAME="College Rules RAG Chatbot"
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# College Rules PDF Configuration
# Place your college rules PDF in backend/data/college_rules.pdf or update the path below
COLLEGE_RULES_PDF=backend/data/college_rules.pdf

# Google Gemini API Credentials
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# RAG & Retrieval Parameters
EMBEDDING_MODEL=gemini-embedding-2
CHAT_MODEL=gemini-3.5-flash-lite
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.58

# Frontend CORS Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
